NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://oms:oms_secret@localhost:5432/oms
ADMIN_PASSWORD=12345
ENCRYPTION_KEY=dev-encryption-key-change-me-32b
# Local Vite + Docker UI + production frontend
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://erm-demo.fybud.com
# Production default: false. Set true only for local empty channel stubs (no seeded demo products/orders).
MOCK_CHANNELS=false
SYNC_CRON=*/5 * * * *
LOG_LEVEL=info
PUBLIC_API_URL=http://localhost:4000
SIMULATION_MODE=true
